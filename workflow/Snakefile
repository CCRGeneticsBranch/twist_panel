"""
Twist Bioscience UMI Panel Preprocessing Pipeline
Based on: DOC-001337 TechNote - Processing Sequencing Data Utilizing UMI (REV1)
"""

import os
import pandas as pd
from pathlib import Path

# This Snakefile expects runtime configuration to be provided via --configfile.
# Run with: snakemake --snakefile /path/to/Snakefile --configfile /path/to/run/config.yaml

RAW_DATA  = config["raw_data_dir"]
RESULTS   = config["results_dir"]
REFERENCE = config["reference_genome"]
BWA_REFERENCE = config["reference_bwa"]

# Load samples
samples_cfg = config["samples"]

# Resolve relative sample metadata paths from the run working directory.
samples_path = samples_cfg if os.path.isabs(samples_cfg) else os.path.abspath(samples_cfg)
if not samples_path.lower().endswith(".tsv"):
    raise ValueError(f"Sample metadata must be a TSV file. Got: {samples_cfg}")

samples_df = pd.read_csv(samples_path, sep="\t")
required_cols = {"Sample", "R1", "R2"}
missing_cols = required_cols - set(samples_df.columns)
if missing_cols:
    raise ValueError(f"Sample metadata TSV is missing required columns: {sorted(missing_cols)}")

if samples_df["Sample"].duplicated().any():
    raise ValueError("Sample metadata TSV contains duplicate sample names in 'Sample' column")

SAMPLES = samples_df.set_index("Sample")[["R1", "R2"]].to_dict("index")
SAMPLE_NAMES = list(SAMPLES.keys()) if SAMPLES else []

# UMI parameters
UMI_PATTERN     = config["umi_pattern"]

# Per-tool module names/versions are looked up directly in each rule
MODULES = config["modules"]

localrules: multiqc

# ---------------------------------------------------------------------------
# Target rule
# ---------------------------------------------------------------------------

rule all:
    input:
        # FastQC on raw reads
        expand(f"{RESULTS}/qc/fastqc/{{sample}}_R1_fastqc.html", sample=SAMPLE_NAMES),
        expand(f"{RESULTS}/qc/fastqc/{{sample}}_R2_fastqc.html", sample=SAMPLE_NAMES),

        # Primary aligned BAM (after first MergeBamAlignment)
        expand(f"{RESULTS}/bam/{{sample}}.merged.bam", sample=SAMPLE_NAMES),
        expand(f"{RESULTS}/bam/{{sample}}.merged.bai", sample=SAMPLE_NAMES),

        # Final consensus BAM (aligned + UMI tags retained)
        expand(f"{RESULTS}/bam/{{sample}}.consensus_final.bam",sample=SAMPLE_NAMES),
        expand(f"{RESULTS}/bam/{{sample}}.consensus_final.bai",sample=SAMPLE_NAMES),

        # MultiQC report
        f"{RESULTS}/qc/multiqc_report.html"


# ---------------------------------------------------------------------------
# Step 1 – FastQC on raw fastq
# ---------------------------------------------------------------------------

rule fastqc_raw:
    input:
        lambda wc: f"{RAW_DATA}/{SAMPLES[wc.sample][wc.read]}"
    output:
        html = f"{RESULTS}/qc/fastqc/{{sample}}_{{read}}_fastqc.html",
        zip = f"{RESULTS}/qc/fastqc/{{sample}}_{{read}}_fastqc.zip"
    params:
        outdir = f"{RESULTS}/qc/fastqc"
    envmodules:
        MODULES["fastqc"]
    shell:
        """
        # Get the input filename without path
        infile=$(basename {input})
        inbase="${{infile%.*}}"  # Remove .gz
        inbase="${{inbase%.*}}"  # Remove .fastq
        
        # Run fastqc
        fastqc -o {params.outdir} {input}
        
        # Rename outputs to match expected naming
        mv {params.outdir}/${{inbase}}_fastqc.html {output.html}
        mv {params.outdir}/${{inbase}}_fastqc.zip {output.zip}
        """

# ---------------------------------------------------------------------------
# Step 2 – Align raw fastqs directly with bwa mem
# ---------------------------------------------------------------------------

rule align_raw_fastq:
    input:
        r1 = lambda wc: f"{RAW_DATA}/{SAMPLES[wc.sample]['R1']}",
        r2 = lambda wc: f"{RAW_DATA}/{SAMPLES[wc.sample]['R2']}"
    output:
        bam = temp(f"{RESULTS}/bam/{{sample}}.aligned.bam")
    params:
        ref = BWA_REFERENCE
    envmodules:
        MODULES["bwa"],
        MODULES["samtools"]
    shell:
        """
        bwa mem -t $SLURM_CPUS_PER_TASK {params.ref} {input.r1} {input.r2} | \
        samtools sort -@ $SLURM_CPUS_PER_TASK -o {output.bam} -
        """


# ---------------------------------------------------------------------------
# Step 3 – Add ZA/ZB/RX tags by parsing UMIs from read names
# ---------------------------------------------------------------------------

rule add_umi_tags_from_read_name:
    input:
        bam = f"{RESULTS}/bam/{{sample}}.aligned.bam"
    output:
        bam = f"{RESULTS}/bam/{{sample}}.merged.bam",
        bai = f"{RESULTS}/bam/{{sample}}.merged.bai"
    params:
        script = os.path.join(workflow.basedir, "scripts", "tag_umi_from_read_name.py"),
        umi_pattern = UMI_PATTERN
    envmodules:
        MODULES["python"],
        MODULES["samtools"],
        MODULES["picard"],
        MODULES["java"]
    shell:
        """
        tmp_bam="{RESULTS}/bam/{wildcards.sample}.merged_no_rg.bam"

        python {params.script} \\
            --input-bam {input.bam} \\
            --output-bam ${{tmp_bam}} \\
            --umi-pattern '{params.umi_pattern}'

        java -Xmx4g -jar $PICARDJARPATH/picard.jar AddOrReplaceReadGroups \\
            I=${{tmp_bam}} \\
            O={output.bam} \\
            RGID={wildcards.sample} \\
            RGLB=Library1 \\
            RGPL=Illumina \\
            RGSM={wildcards.sample} \\
            RGPU=Unit1 \\
            CREATE_INDEX=false

        samtools index {output.bam} {output.bai}
        rm -f "${{tmp_bam}}"
        """

# ---------------------------------------------------------------------------
# Step 4 – Picard CollectHsMetrics  (PDF step 6)
# Coverage QC on pre-consensus alignments
# ---------------------------------------------------------------------------

rule collect_hs_metrics:
    """
    PDF command:
      java -Xmx4g -jar picard.jar CollectHsMetrics \\
        -I {aligned_tag_umi_bam} \\
        -O {metrics_file}	\\
        -R {reference_fasta} \\
        --BAIT_INTERVALS {probes_intervals} \\
        --TARGET_INTERVALS	target_file_UMI_demo_data_hg38.bed	\\		
        --PER_TARGET_COVERAGE	probe_file_UMI_demo_data_hg38.bed
    """
    input:
        bam = f"{RESULTS}/bam/{{sample}}.merged.bam"
    output:
        metrics = f"{RESULTS}/qc/hsmetrics/{{sample}}.pre_consensus_hs_metrics.txt",
        per_target_coverage = f"{RESULTS}/qc/hsmetrics/{{sample}}.pre_consensus_per_target_coverage.txt"
    params:
        ref = REFERENCE,
        bait_intervals = config["bait_intervals"],
        target_intervals = config["target_intervals"]
    envmodules:
        MODULES["picard"],
        MODULES["java"]
    shell:
        """
        java -Xmx4g -jar $PICARDJARPATH/picard.jar CollectHsMetrics \
            -I {input.bam} \\
            -R {params.ref} \\
            -O {output.metrics} \\
            --BAIT_INTERVALS {params.bait_intervals} \\
            --TARGET_INTERVALS {params.target_intervals} \\
            --PER_TARGET_COVERAGE {output.per_target_coverage}
        """

# ---------------------------------------------------------------------------
# Step 5 – fgbio SetMateInformation
# Ensures mate tags (MQ/MC) are present before GroupReadsByUmi --strategy=paired
# ---------------------------------------------------------------------------

rule set_mate_information:
    input:
        bam = f"{RESULTS}/bam/{{sample}}.merged.bam"
    output:
        bam = temp(f"{RESULTS}/bam/{{sample}}.merged.mate_fixed.bam"),
        bai = temp(f"{RESULTS}/bam/{{sample}}.merged.mate_fixed.bai")
    envmodules:
        MODULES["fgbio"],
        MODULES["java"],
        MODULES["samtools"]
    shell:
        """
        qname_bam="{RESULTS}/bam/{wildcards.sample}.merged.qname.bam"
        mate_fixed_qname_bam="{RESULTS}/bam/{wildcards.sample}.merged.mate_fixed.qname.bam"

        samtools sort -n -@ $SLURM_CPUS_PER_TASK -o ${{qname_bam}} {input.bam}

        java -Xmx4g -Djava.io.tmpdir=/lscratch/$SLURM_JOB_ID -jar $FGBIO_JAR SetMateInformation \
            --input ${{qname_bam}} \
            --output ${{mate_fixed_qname_bam}} \
            --allow-missing-mates true

        samtools sort -@ $SLURM_CPUS_PER_TASK -o {output.bam} ${{mate_fixed_qname_bam}}
        samtools index {output.bam} {output.bai}

        rm -f "${{qname_bam}}" "${{mate_fixed_qname_bam}}"
        """

# ---------------------------------------------------------------------------
# Step 6 – fgbio GroupReadsByUmi  (PDF step 7)
# Groups read pairs by mapped position + UMI into UMI families
# Must use --strategy=paired for CallDuplexConsensusReads
# Adds MI tag
# ---------------------------------------------------------------------------

rule group_reads_by_umi:
    """
    PDF command:
      java -Xmx4g -jar fgbio.jar GroupReadsByUmi \\
        --strategy=paired \\
        --input={aligned_tag_umi_bam} \\
        --output={grouped_by_umi_bam} \\
        --raw-tag=RX \\
        --min-map-q=10 \\
        --edits=1
    """
    input:
        bam = f"{RESULTS}/bam/{{sample}}.merged.mate_fixed.bam",
        bai = f"{RESULTS}/bam/{{sample}}.merged.mate_fixed.bai"
    output:
        bam = temp(f"{RESULTS}/bam/{{sample}}.grouped.bam"),
        hist = f"{RESULTS}/bam/{{sample}}.family_size_histogram.txt"
    params:
        min_mapq = config["min_map_quality"]
    envmodules:
        MODULES["fgbio"],
        MODULES["java"]
    shell:
        """
        java -Xmx4g -Djava.io.tmpdir=/lscratch/$SLURM_JOB_ID -jar $FGBIO_JAR GroupReadsByUmi \\
            --strategy=paired \\
            --input={input.bam} \\
            --output={output.bam} \\
            --family-size-histogram={output.hist} \\
            --raw-tag=RX \\
            --min-map-q={params.min_mapq} \\
            --edits=1
        """

# ---------------------------------------------------------------------------
# Step 7 – fgbio CallDuplexConsensusReads  (PDF step 8)
# Assembles single-strand consensus reads, then combines
# the two strands into a duplex consensus read.
#
#   --min-reads 2 1 1:
#      first integer  = duplex filter (≥2 total reads to form a consensus)
#      second integer = min reads from the first strand
#      third integer  = min reads from the second strand
#    Twist recommend 2 1 1 to require evidence from both strands.
# ---------------------------------------------------------------------------

rule call_duplex_consensus:
    """
    PDF command:
      java -Xmx4g -jar fgbio.jar CallDuplexConsensusReads \\
        --input={grouped_by_umi_bam} \\
        --output={unaligned_consensus_bam} \\
        --error-rate-pre-umi=45 \\
        --error-rate-post-umi=30 \\
        --min-input-base-quality=30	\\
        --min-reads 2 1 1
    """
    input:
        bam = f"{RESULTS}/bam/{{sample}}.grouped.bam"
    output:
        ubam = temp(f"{RESULTS}/bam/{{sample}}.consensus_unmapped.bam")
    params:
        min_input_base_quality = config["min_input_base_quality"],
        min_reads = config["min_reads"]
    envmodules:
        MODULES["fgbio"],
        MODULES["java"]
    shell:
        """
        java -Xmx4g -Djava.io.tmpdir=/lscratch/$SLURM_JOB_ID -jar $FGBIO_JAR CallDuplexConsensusReads \\
            --input={input.bam} \\
            --output={output.ubam} \\
            --error-rate-pre-umi=45 \\
            --error-rate-post-umi=30 \\
            --min-input-base-quality={params.min_input_base_quality}	\\
            --min-reads {params.min_reads}
        """

# ---------------------------------------------------------------------------
# Step 8 – Picard SamToFastq  →  bwa mem -p  (PDF step 9)
# Realign consensus reads after duplex consensus calling
# ---------------------------------------------------------------------------

rule realign_consensus:
    """
    PDF commands:
      java -Xmx4g -jar picard.jar SamToFastq \\
        I={unaligned_consensus_bam} F={fastq_consensus} INTERLEAVE=true

      bwa mem -p -t 8 {ref} -o {aligned_bam_consensus} {fastq_consensus}
    """
    input:
        ubam = f"{RESULTS}/bam/{{sample}}.consensus_unmapped.bam"
    output:
        bam = temp(f"{RESULTS}/bam/{{sample}}.consensus_aligned.bam")
    params:
        ref = BWA_REFERENCE
    envmodules:
        MODULES["picard"],
        MODULES["java"],
        MODULES["bwa"],
        MODULES["samtools"]
    shell:
        """
        set -euo pipefail

        java -Xmx4g -jar $PICARDJARPATH/picard.jar SamToFastq \
            I={input.ubam} \\
            F=/dev/stdout \\
            INTERLEAVE=true \\
            QUIET=true | \\
        bwa mem -p -t $SLURM_CPUS_PER_TASK {params.ref} - | \\
        samtools sort -@ $SLURM_CPUS_PER_TASK -o {output.bam} -
        """

# ---------------------------------------------------------------------------
# Step 9 – Second Picard MergeBamAlignment  (PDF step 10)
# Merges the re-aligned consensus BAM with the consensus uBAM to restore
# duplex UMI tags (ZS, ZI, ZM, ZC, ZN, ...) needed for downstream tools.
# ---------------------------------------------------------------------------

rule merge_consensus_bam:
    """
    PDF command:
      java -Xmx4g -jar picard.jar MergeBamAlignment \\
        VALIDATION_STRINGENCY=SILENT \\
        UNMAPPED={unaligned_consensus_bam} \\
        ALIGNED={aligned_bam_consensus} \\
        O={merged_consensus_bam} \\
        R={reference_fasta} \\
        CLIP_ADAPTERS=false \\
        CREATE_INDEX=true \\
        EXPECTED_ORIENTATIONS=FR \\
        MAX_GAPS=-1 \\
        SORT_ORDER=coordinate \\
        ALIGNER_PROPER_PAIR_FLAGS=false \\
        ATTRIBUTES_TO_RETAIN=X0 \\
        ATTRIBUTES_TO_RETAIN=ZS \\
        ATTRIBUTES_TO_RETAIN=ZI \\
        ATTRIBUTES_TO_RETAIN=ZM \\
        ATTRIBUTES_TO_RETAIN=ZC \\
        ATTRIBUTES_TO_RETAIN=ZN \\
        ATTRIBUTES_TO_RETAIN=ad \\
        ATTRIBUTES_TO_RETAIN=bd \\
        ATTRIBUTES_TO_RETAIN=cd \\
        ATTRIBUTES_TO_RETAIN=ae \\
        ATTRIBUTES_TO_RETAIN=be \\
        ATTRIBUTES_TO_RETAIN=ce

        java -Xmx4g -jar /path/to/picard.jar AddOrReplaceReadGroups \\
            I={merged_no_read_group_bam} \\
            O={consensus_aligned_merged_bam} \\
            RGID={sample_id} \\
            RGLB={sample_lib} \\
            RGPL=Illumina \\
            RGSM={sample_name} \\
            RGPU=NA
    """
    input:
        ubam = f"{RESULTS}/bam/{{sample}}.consensus_unmapped.bam",
        aligned = f"{RESULTS}/bam/{{sample}}.consensus_aligned.bam"
    output:
        bam = f"{RESULTS}/bam/{{sample}}.consensus_final.bam",
        bai = f"{RESULTS}/bam/{{sample}}.consensus_final.bai",
        no_rg_bam = temp(f"{RESULTS}/bam/{{sample}}.consensus_no_rg.bam"),
        no_rg_bai = temp(f"{RESULTS}/bam/{{sample}}.consensus_no_rg.bai")
    params:
        ref = REFERENCE
    envmodules:
        MODULES["picard"],
        MODULES["java"]
    shell:
        """
        set -euo pipefail

        ubam_qname_bam="{RESULTS}/bam/{wildcards.sample}.consensus_unmapped.qname.bam"
        aligned_qname_bam="{RESULTS}/bam/{wildcards.sample}.consensus_aligned.qname.bam"

        java -Xmx4g -jar $PICARDJARPATH/picard.jar SortSam \
            I={input.ubam} \
            O=${{ubam_qname_bam}} \
            SORT_ORDER=queryname \
            CREATE_INDEX=false

        java -Xmx4g -jar $PICARDJARPATH/picard.jar SortSam \
            I={input.aligned} \
            O=${{aligned_qname_bam}} \
            SORT_ORDER=queryname \
            CREATE_INDEX=false

        java -Xmx4g -jar $PICARDJARPATH/picard.jar MergeBamAlignment \\
            VALIDATION_STRINGENCY=SILENT \\
            UNMAPPED=${{ubam_qname_bam}} \\
            ALIGNED=${{aligned_qname_bam}} \\
            O={output.no_rg_bam} \\
            R={params.ref} \\
            CLIP_ADAPTERS=false \\
            CREATE_INDEX=true \\
            EXPECTED_ORIENTATIONS=FR \\
            MAX_GAPS=-1 \\
            SORT_ORDER=coordinate \\
            ALIGNER_PROPER_PAIR_FLAGS=false \\
            ATTRIBUTES_TO_RETAIN=X0 \\
            ATTRIBUTES_TO_RETAIN=ZS \\
            ATTRIBUTES_TO_RETAIN=ZI \\
            ATTRIBUTES_TO_RETAIN=ZM \\
            ATTRIBUTES_TO_RETAIN=ZC \\
            ATTRIBUTES_TO_RETAIN=ZN \\
            ATTRIBUTES_TO_RETAIN=ad \\
            ATTRIBUTES_TO_RETAIN=bd \\
            ATTRIBUTES_TO_RETAIN=cd \\
            ATTRIBUTES_TO_RETAIN=ae \\
            ATTRIBUTES_TO_RETAIN=be \\
            ATTRIBUTES_TO_RETAIN=ce

        java -Xmx4g -jar $PICARDJARPATH/picard.jar AddOrReplaceReadGroups \\
            I={output.no_rg_bam} \\
            O={output.bam} \\
            RGID={wildcards.sample} \\
            RGLB=Library1 \\
            RGPL=Illumina \\
            RGSM={wildcards.sample} \\
            RGPU=NA \\
            CREATE_INDEX=true

        rm -f "${{ubam_qname_bam}}" "${{aligned_qname_bam}}"
        """

# ---------------------------------------------------------------------------
# Step 10 – Picard CollectHsMetrics  (PDF step 10a)
# Post-consensus QC: fold-80, coverage, off-target rates.
# ---------------------------------------------------------------------------

rule collect_hs_metrics_post:
    """
    PDF command:
      java -Xmx4g -jar picard.jar CollectHsMetrics \\
        -I {consensus_aligned_merged_bam} \\
        -O {metrics_file}	\\
        -R {reference_fasta} \\
        --BAIT_INTERVALS {probes_intervals} \\
        --TARGET_INTERVALS	target_file_UMI_demo_data_hg38.bed	\\		
        --PER_TARGET_COVERAGE	probe_file_UMI_demo_data_hg38.bed
    """
    input:
        bam = f"{RESULTS}/bam/{{sample}}.consensus_final.bam"
    output:
        metrics = f"{RESULTS}/qc/hsmetrics/{{sample}}.consensus_hs_metrics.txt",
        per_target_coverage = f"{RESULTS}/qc/hsmetrics/{{sample}}.consensus_per_target_coverage.txt"
    params:
        ref = REFERENCE,
        bait_intervals = config["bait_intervals"],
        target_intervals = config["target_intervals"]
    envmodules:
        MODULES["picard"],
        MODULES["java"]
    shell:
        """
        java -Xmx4g -jar $PICARDJARPATH/picard.jar CollectHsMetrics \
            -I {input.bam} \\
            -R {params.ref} \\
            -O {output.metrics} \\
            --BAIT_INTERVALS {params.bait_intervals} \\
            --TARGET_INTERVALS {params.target_intervals} \\
            --PER_TARGET_COVERAGE {output.per_target_coverage}
        """

# ---------------------------------------------------------------------------
# MultiQC
# Aggregate all QC reports (FastQC + HsMetrics + UMI family size histograms)
# ---------------------------------------------------------------------------

rule multiqc:
    input:
        expand(f"{RESULTS}/qc/fastqc/{{sample}}_{{read}}_fastqc.zip",
               sample=SAMPLE_NAMES, read=["R1", "R2"]),
        expand(f"{RESULTS}/qc/hsmetrics/{{sample}}.pre_consensus_hs_metrics.txt",
               sample=SAMPLE_NAMES),
        expand(f"{RESULTS}/qc/hsmetrics/{{sample}}.consensus_hs_metrics.txt",
               sample=SAMPLE_NAMES),
        expand(f"{RESULTS}/bam/{{sample}}.family_size_histogram.txt",
               sample=SAMPLE_NAMES)
    output:
        f"{RESULTS}/qc/multiqc_report.html"
    params:
        indir = RESULTS,
        outdir = f"{RESULTS}/qc"
    envmodules:
        MODULES["multiqc"]
    shell:
        "multiqc {params.indir} -o {params.outdir} -f --fn_as_s_name"
