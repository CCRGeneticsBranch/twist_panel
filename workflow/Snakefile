"""
Twist Bioscience UMI Panel Preprocessing Pipeline
Based on: DOC-001337 TechNote - Processing Sequencing Data Utilizing UMI (REV1)
"""

import os
import pandas as pd
from pathlib import Path

# This Snakefile expects runtime configuration to be provided via --configfile.
# Run with: snakemake --snakefile /path/to/Snakefile --configfile /path/to/run/config.yaml

RAW_DATA  = config["raw_data_dir"]
RESULTS   = config["results_dir"]
LOGS      = config["logs_dir"]
REFERENCE = config["reference_genome"]

# Load samples
samples_cfg = config["samples"]

# Resolve relative sample metadata paths from the run working directory.
samples_path = samples_cfg if os.path.isabs(samples_cfg) else os.path.abspath(samples_cfg)
if not samples_path.lower().endswith(".tsv"):
    raise ValueError(f"Sample metadata must be a TSV file. Got: {samples_cfg}")

samples_df = pd.read_csv(samples_path, sep="\t")
required_cols = {"Sample", "R1", "R2"}
missing_cols = required_cols - set(samples_df.columns)
if missing_cols:
    raise ValueError(f"Sample metadata TSV is missing required columns: {sorted(missing_cols)}")

if samples_df["Sample"].duplicated().any():
    raise ValueError("Sample metadata TSV contains duplicate sample names in 'Sample' column")

SAMPLES = samples_df.set_index("Sample")[["R1", "R2"]].to_dict("index")
SAMPLE_NAMES = list(SAMPLES.keys()) if SAMPLES else []

THREADS = config["threads"]
MEMORY  = config["memory_gb"]   # per-tool heap (matches PDF: -Xmx4g)

# UMI parameters
UMI_PATTERN     = config["umi_pattern"]
READ_STRUCTURE  = config["umi_read_structure"]

# Per-tool module names/versions are looked up directly in each rule
MODULES = config["modules"]


# ---------------------------------------------------------------------------
# Target rule
# ---------------------------------------------------------------------------

rule all:
    input:
        # FastQC on raw reads
        expand(f"{RESULTS}/qc/fastqc/{{sample}}.R1_fastqc.html", sample=SAMPLE_NAMES),
        expand(f"{RESULTS}/qc/fastqc/{{sample}}.R2_fastqc.html", sample=SAMPLE_NAMES),

        # Pre-processed fastqs (UMIs moved inline from header)
        expand(f"{RESULTS}/umi_extracted/{{sample}}.R1.fastq.gz", sample=SAMPLE_NAMES),
        expand(f"{RESULTS}/umi_extracted/{{sample}}.R2.fastq.gz", sample=SAMPLE_NAMES),

        # uBAM with UMI tags (ZA / ZB / RX)
        expand(f"{RESULTS}/bam/{{sample}}.umi_tagged.bam", sample=SAMPLE_NAMES),

        # Primary aligned BAM (after first MergeBamAlignment)
        expand(f"{RESULTS}/bam/{{sample}}.merged.bam", sample=SAMPLE_NAMES),
        expand(f"{RESULTS}/bam/{{sample}}.merged.bai", sample=SAMPLE_NAMES),

        # Grouped-by-UMI BAM
        expand(f"{RESULTS}/bam/{{sample}}.grouped.bam", sample=SAMPLE_NAMES),

        # Final consensus BAM (aligned + UMI tags retained)
        expand(f"{RESULTS}/bam/{{sample}}.consensus_final.bam",
               sample=SAMPLE_NAMES),
        expand(f"{RESULTS}/bam/{{sample}}.consensus_final.bai",
               sample=SAMPLE_NAMES),
        
        # MultiQC and summary report
        f"{RESULTS}/qc/multiqc_report.html",
        f"{RESULTS}/summary_report.txt"


# ---------------------------------------------------------------------------
# Step 1 – FastQC on raw fastq
# ---------------------------------------------------------------------------

rule fastqc_raw:
    input:
        lambda wc: f"{RAW_DATA}/{SAMPLES[wc.sample][wc.read]}"
    output:
        html = f"{RESULTS}/qc/fastqc/{{sample}}.{{read}}_fastqc.html",
        zip = f"{RESULTS}/qc/fastqc/{{sample}}.{{read}}_fastqc.zip"
    params:
        outdir = f"{RESULTS}/qc/fastqc"
    log:
        f"{LOGS}/qc/{{sample}}.{{read}}_fastqc.log"
    envmodules:
        MODULES["fastqc"]
    shell:
        "fastqc -o {params.outdir} -f fastq {input} 2>&1 | tee {log}"

# ---------------------------------------------------------------------------
# Step 2 – Custom: move UMIs from header into reads inline
#
# Parse UMI1+UMI2 from the read name and prepend to its read:
#       UMI1 → first 5 bases of R1  (read structure 5M+T)
#       UMI2 → first 5 bases of R2  (read structure 5M+T)
# Since UMIs are in the read name (not at the start of the read sequence)
# we prepend UMI1 → R1 and UMI2 → R2 so the standard fgbio ExtractUmisFromBam
# read-structure can strip them into ZA/ZB/RX tags downstream.
# ---------------------------------------------------------------------------

rule extract_umi_from_header:
    input:
        r1 = lambda wc: f"{RAW_DATA}/{SAMPLES[wc.sample]['R1']}",
        r2 = lambda wc: f"{RAW_DATA}/{SAMPLES[wc.sample]['R2']}"
    output:
        r1 = f"{RESULTS}/umi_extracted/{{sample}}.R1.fastq.gz",
        r2 = f"{RESULTS}/umi_extracted/{{sample}}.R2.fastq.gz",
        stats = f"{RESULTS}/umi_extracted/{{sample}}.umi_stats.txt"
    params:
        script = os.path.join(workflow.basedir, "scripts", "extract_umi.py"),
        umi_pattern = UMI_PATTERN
    log:
        f"{LOGS}/umi_extracted/{{sample}}.log"
    envmodules:
        MODULES["python"]
    shell:
        """
        python {params.script} \
            --r1 {input.r1} --r2 {input.r2} \
            --out_r1 {output.r1} --out_r2 {output.r2} \
            --stats {output.stats} \
            --umi_pattern '{params.umi_pattern}' \
            --split_umis \
            2>&1 | tee {log}
        """

# ---------------------------------------------------------------------------
# Step 3 – Picard FastqToSam  (PDF step 1)
# Convert paired fastqs to an unmapped BAM with sample metadata
# ---------------------------------------------------------------------------

rule fastq_to_sam:
    """
    PDF command:
      java -Xmx4g -jar picard.jar FastqToSam \\
        O={unaligned_bam} F1={r1} F2={r2} \\
        SM={sample} LB=Library1 PU=Unit1 PL=Illumina
    """
    input:
        r1 = f"{RESULTS}/umi_extracted/{{sample}}.R1.fastq.gz",
        r2 = f"{RESULTS}/umi_extracted/{{sample}}.R2.fastq.gz"
    output:
        ubam = temp(f"{RESULTS}/bam/{{sample}}.unmapped.bam")
    params:
        mem = MEMORY,
        sample = lambda wc: wc.sample
    log:
        f"{LOGS}/bam/{{sample}}.fastq_to_sam.log"
    envmodules:
        MODULES["picard"],
        MODULES["java"]
    shell:
        """
        picard --java-options "-Xmx{params.mem}g" FastqToSam \\
            O={output.ubam} \\
            F1={input.r1} \\
            F2={input.r2} \\
            SM={params.sample} \\
            LB=Library1 \\
            PU=Unit1 \\
            PL=Illumina \\
            2>&1 | tee {log}
        """

# ---------------------------------------------------------------------------
# Step 4 – fgbio ExtractUmisFromBam  (PDF step 2)
# Strips the inline UMI prefix from each read and stores it in tags.
#   ZA = 5' UMI (from R1)
#   ZB = 3' UMI (from R2)
#   RX = combined "UMI1-UMI2"
# Adaptation: read structure is 5M+T (no skip) because skip bases are not
# present in UMIs extracted from the read-name header.
# ---------------------------------------------------------------------------

rule extract_umis_from_bam:
    """
    PDF command:
      java -Xmx4g -jar fgbio.jar ExtractUmisFromBam \\
        --input={unaligned_bam} \\
        --output={unaligned_bam_umi_extracted} \\
        --read-structure=5M2S+T 5M2S+T \\
        --molecular-index-tags=ZA ZB \\
        --single-tag=RX
    """
    input:
        ubam = f"{RESULTS}/bam/{{sample}}.unmapped.bam"
    output:
        ubam_umi = f"{RESULTS}/bam/{{sample}}.umi_tagged.bam"
    params:
        rs = READ_STRUCTURE
    log:
        f"{LOGS}/bam/{{sample}}.extract_umis.log"
    envmodules:
        MODULES["fgbio"],
        MODULES["java"]
    shell:
        """
        fgbio ExtractUmisFromBam \\
            --input={input.ubam} \\
            --output={output.ubam_umi} \\
            --read-structure={params.rs} {params.rs} \\
            --molecular-index-tags=ZA ZB \\
            --single-tag=RX \\
            2>&1 | tee {log}
        """

# ---------------------------------------------------------------------------
# Steps 5 + 6 – Picard SamToFastq →  bwa mem -p  (PDF steps 3 + 4)
# Convert UMI-tagged uBAM → interleaved fastq, then align with bwa mem
# and coordinate sort
# ---------------------------------------------------------------------------

rule sam_to_fastq_and_align:
    """
    PDF commands:
      java -Xmx4g -jar picard.jar SamToFastq \\
        I={ubam_umi_extracted} F={fastq_umi_extracted} INTERLEAVE=true

      bwa mem -p -t 8 {ref} {fastq_umi_extracted} | \\
        samtools sort -@ 8 -o {aligned_bam}
    """
    input:
        ubam_umi = f"{RESULTS}/bam/{{sample}}.umi_tagged.bam"
    output:
        bam = temp(f"{RESULTS}/bam/{{sample}}.aligned.bam")
    params:
        mem = MEMORY,
        ref = REFERENCE
    threads: THREADS
    log:
        f"{LOGS}/bam/{{sample}}.align.log"
    envmodules:
        MODULES["picard"],
        MODULES["java"],
        MODULES["bwa"],
        MODULES["samtools"]
    shell:
        """
        picard --java-options "-Xmx{params.mem}g" SamToFastq \\
            I={input.ubam_umi} \\
            F=/dev/stdout \\
            INTERLEAVE=true \\
            QUIET=true \\
            2>>{log} | \\
        bwa mem -p -t {threads} {params.ref} /dev/stdin 2>>{log} | \\
        samtools sort -@ {threads} -o {output.bam} -
        """

# ---------------------------------------------------------------------------
# Step 7 – Picard MergeBamAlignment  (PDF step 5)
# Merges the aligned BAM with the UMI-tagged uBAM so that aligned records
# carry the ZA/ZB/RX tags and all Picard metadata.
# ---------------------------------------------------------------------------

rule merge_bam_alignment:
    """
    PDF command:
      java -Xmx4g -jar picard.jar MergeBamAlignment \\
        UNMAPPED={unaligned_bam_umi_extracted} \\
        ALIGNED={aligned_bam_umi_extracted} \\
        O={aligned_tag_umi_bam} \\
        R={reference_fasta} \\
        CLIP_ADAPTERS=false \\
        VALIDATION_STRINGENCY=SILENT \\
        CREATE_INDEX=true \\
        EXPECTED_ORIENTATIONS=FR \\
        MAX_GAPS=-1 \\
        SO=coordinate \\
        ALIGNER_PROPER_PAIR_FLAGS=false
    """
    input:
        ubam = f"{RESULTS}/bam/{{sample}}.umi_tagged.bam",
        aligned = f"{RESULTS}/bam/{{sample}}.aligned.bam"
    output:
        bam = f"{RESULTS}/bam/{{sample}}.merged.bam",
        bai = f"{RESULTS}/bam/{{sample}}.merged.bai"
    params:
        mem = MEMORY,
        ref = REFERENCE
    log:
        f"{LOGS}/bam/{{sample}}.merge.log"
    envmodules:
        MODULES["picard"],
        MODULES["java"]
    shell:
        """
        picard --java-options "-Xmx{params.mem}g" MergeBamAlignment \\
            UNMAPPED={input.ubam} \\
            ALIGNED={input.aligned} \\
            O={output.bam} \\
            R={params.ref} \\
            CLIP_ADAPTERS=false \\
            VALIDATION_STRINGENCY=SILENT \\
            CREATE_INDEX=true \\
            EXPECTED_ORIENTATIONS=FR \\
            MAX_GAPS=-1 \\
            SO=coordinate \\
            ALIGNER_PROPER_PAIR_FLAGS=false \\
            2>&1 | tee {log}
        """

# ---------------------------------------------------------------------------
# Step 8 – Picard CollectHsMetrics  (PDF step 6)
# Coverage QC on pre-consensus alignments
# ---------------------------------------------------------------------------

rule collect_hs_metrics:
    """
    PDF command:
      java -Xmx4g -jar picard.jar CollectHsMetrics \\
        -I {aligned_tag_umi_bam} \\
        -O {metrics_file}	\\
        -R {reference_fasta} \\
        --BAIT_INTERVALS {probes_intervals} \\
        --TARGET_INTERVALS	target_file_UMI_demo_data_hg38.bed	\\		
        --PER_TARGET_COVERAGE	probe_file_UMI_demo_data_hg38.bed
    """
    input:
        bam = f"{RESULTS}/bam/{{sample}}.merged.bam"
    output:
        metrics = f"{RESULTS}/qc/{{sample}}.pre_consensus_hs_metrics.txt"
    params:
        mem = MEMORY,
        ref = REFERENCE,
        bait_intervals = config["bait_intervals"],
        target_intervals = config["target_intervals"],
        probe_file = config["probe_file"]
    log:
        f"{LOGS}/qc/{{sample}}.pre_consensus_hs_metrics.log"
    envmodules:
        MODULES["picard"],
        MODULES["java"]
    shell:
        """
        picard --java-options "-Xmx{params.mem}g" CollectHsMetrics \\
            -I {input.bam} \\
            -R {params.ref} \\
            -O {output.metrics} \\
            --BAIT_INTERVALS {params.bait_intervals} \\
            --TARGET_INTERVALS {params.target_intervals} \\
            --PER_TARGET_COVERAGE {params.probe_file} \\
            2>&1 | tee {log}
        """

# ---------------------------------------------------------------------------
# Step 9 – fgbio GroupReadsByUmi  (PDF step 7)
# Groups read pairs by mapped position + UMI into UMI families
# Must use --strategy=paired for CallDuplexConsensusReads.
# ---------------------------------------------------------------------------

rule group_reads_by_umi:
    """
    PDF command:
      java -Xmx4g -jar fgbio.jar GroupReadsByUmi \\
        --strategy=paired \\
        --input={aligned_tag_umi_bam} \\
        --output={grouped_by_umi_bam} \\
        --raw-tag=RX \\
        --min-map-q=10 \\
        --edits=1
    """
    input:
        bam = f"{RESULTS}/bam/{{sample}}.merged.bam",
        bai = f"{RESULTS}/bam/{{sample}}.merged.bai"
    output:
        bam = f"{RESULTS}/bam/{{sample}}.grouped.bam",
        hist = f"{RESULTS}/bam/{{sample}}.family_size_histogram.txt"
    params:
        min_mapq = config["min_map_quality"],
        edits = config["umi_edit_distance"]
    log:
        f"{LOGS}/bam/{{sample}}.group_by_umi.log"
    envmodules:
        MODULES["fgbio"],
        MODULES["java"]
    shell:
        """
        fgbio GroupReadsByUmi \\
            --strategy=paired \\
            --input={input.bam} \\
            --output={output.bam} \\
            --family-size-histogram={output.hist} \\
            --raw-tag=RX \\
            --min-map-q={params.min_mapq} \\
            --edits={params.edits} \\
            2>&1 | tee {log}
        """

# ---------------------------------------------------------------------------
# Step 10 – fgbio CallDuplexConsensusReads  (PDF step 8)
# Assembles single-strand consensus reads, then combines
# the two strands into a duplex consensus read.
#
#   --min-reads 2 1 1:
#      first integer  = duplex filter (≥2 total reads to form a consensus)
#      second integer = min reads from the first strand
#      third integer  = min reads from the second strand
#    Twist recommend 2 1 1 to require evidence from both strands.
# ---------------------------------------------------------------------------

rule call_duplex_consensus:
    """
    PDF command:
      java -Xmx4g -jar fgbio.jar CallDuplexConsensusReads \\
        --input={grouped_by_umi_bam} \\
        --output={unaligned_consensus_bam} \\
        --error-rate-pre-umi=45 \\
        --error-rate-post-umi=30 \\
        --min-input-base-quality=30	\\
        --min-reads 2 1 1
    """
    input:
        bam = f"{RESULTS}/bam/{{sample}}.grouped.bam"
    output:
        ubam = f"{RESULTS}/bam/{{sample}}.consensus_unmapped.bam"
    params:
        error_rate_pre = config["error_rate_pre_umi"],
        min_reads = config["min_reads"]
    log:
        f"{LOGS}/bam/{{sample}}.call_duplex.log"
    envmodules:
        MODULES["fgbio"],
        MODULES["java"]
    shell:
        """
        fgbio CallDuplexConsensusReads \\
            --input={input.bam} \\
            --output={output.ubam} \\
            --error-rate-pre-umi={params.error_rate_pre} \\
            --error-rate-post-umi=30 \\
            --min-input-base-quality=30	\\
            --min-reads {params.min_reads} \\
            2>&1 | tee {log}
        """

# ---------------------------------------------------------------------------
# Steps 11 + 12 – Picard SamToFastq  →  bwa mem -p  (PDF step 9)
# Realign consensus reads (same as steps 3+4)
# ---------------------------------------------------------------------------

rule realign_consensus:
    """
    PDF commands:
      java -Xmx4g -jar picard.jar SamToFastq \\
        I={unaligned_consensus_bam} F={fastq_consensus} INTERLEAVE=true

      bwa mem -p -t 8 {ref} -o {aligned_bam_consensus} {fastq_consensus}
    """
    input:
        ubam = f"{RESULTS}/bam/{{sample}}.consensus_unmapped.bam"
    output:
        bam = temp(f"{RESULTS}/bam/{{sample}}.consensus_aligned.bam")
    params:
        mem = MEMORY,
        ref = REFERENCE
    threads: THREADS
    log:
        f"{LOGS}/bam/{{sample}}.consensus_align.log"
    envmodules:
        MODULES["picard"],
        MODULES["java"],
        MODULES["bwa"],
        MODULES["samtools"]
    shell:
        """
        picard --java-options "-Xmx{params.mem}g" SamToFastq \\
            I={input.ubam} \\
            F=/dev/stdout \\
            INTERLEAVE=true \\
            QUIET=true \\
            2>>{log} | \\
        bwa mem -p -t {threads} {params.ref} /dev/stdout 2>>{log} | \\
        samtools sort -@ {threads} -o {output.bam} -
        """

# ---------------------------------------------------------------------------
# Step 13 – Second Picard MergeBamAlignment  (PDF step 10)
# Merges the re-aligned consensus BAM with the consensus uBAM to restore
# duplex UMI tags (ZS, ZI, ZM, ZC, ZN, ...) needed for downstream tools.
# ---------------------------------------------------------------------------

rule merge_consensus_bam:
    """
    PDF command:
      java -Xmx4g -jar picard.jar MergeBamAlignment \\
        VALIDATION_STRINGENCY=SILENT \\
        UNMAPPED={unaligned_consensus_bam} \\
        ALIGNED={aligned_bam_consensus} \\
        O={merged_consensus_bam} \\
        R={reference_fasta} \\
        CLIP_ADAPTERS=false \\
        CREATE_INDEX=true \\
        EXPECTED_ORIENTATIONS=FR \\
        MAX_GAPS=-1 \\
        SORT_ORDER=coordinate \\
        ALIGNER_PROPER_PAIR_FLAGS=false \\
        ATTRIBUTES_TO_RETAIN=X0 \\
        ATTRIBUTES_TO_RETAIN=ZS \\
        ATTRIBUTES_TO_RETAIN=ZI \\
        ATTRIBUTES_TO_RETAIN=ZM \\
        ATTRIBUTES_TO_RETAIN=ZC \\
        ATTRIBUTES_TO_RETAIN=ZN \\
        ATTRIBUTES_TO_RETAIN=ad \\  
        ATTRIBUTES_TO_RETAIN=bd \\ 
        ATTRIBUTES_TO_RETAIN=cd \\
        ATTRIBUTES_TO_RETAIN=ae \\
        ATTRIBUTES_TO_RETAIN=be \\
        ATTRIBUTES_TO_RETAIN=ce

        java -Xmx4g -jar /path/to/picard.jar AddOrReplaceReadGroups \\
            I={merged_no_read_group_bam} \\
            O={consensus_aligned_merged_bam} \\
            RGID={sample_id} \\
            RGLB={sample_lib} \\
            RGPL=Illumina \\
            RGSM={sample_name} \\
            RGPU=NA
    """
    input:
        ubam = f"{RESULTS}/bam/{{sample}}.consensus_unmapped.bam",
        aligned = f"{RESULTS}/bam/{{sample}}.consensus_aligned.bam"
    output:
        bam = f"{RESULTS}/bam/{{sample}}.consensus_final.bam",
        bai = f"{RESULTS}/bam/{{sample}}.consensus_final.bai",
        no_rg_bam = temp(f"{RESULTS}/bam/{{sample}}.consensus_no_rg.bam"),
        no_rg_bai = temp(f"{RESULTS}/bam/{{sample}}.consensus_no_rg.bai")
    params:
        mem = MEMORY,
        ref = REFERENCE
    log:
        f"{LOGS}/bam/{{sample}}.consensus_merge.log"
    envmodules:
        MODULES["picard"],
        MODULES["java"]
    shell:
        """
        picard --java-options "-Xmx{params.mem}g" MergeBamAlignment \\
            VALIDATION_STRINGENCY=SILENT \\
            UNMAPPED={input.ubam} \\
            ALIGNED={input.aligned} \\
            O={output.no_rg_bam} \\
            R={params.ref} \\
            CLIP_ADAPTERS=false \\
            CREATE_INDEX=true \\
            EXPECTED_ORIENTATIONS=FR \\
            MAX_GAPS=-1 \\
            SORT_ORDER=coordinate \\
            ALIGNER_PROPER_PAIR_FLAGS=false \\
            ATTRIBUTES_TO_RETAIN=X0 \\
            ATTRIBUTES_TO_RETAIN=ZS \\
            ATTRIBUTES_TO_RETAIN=ZI \\
            ATTRIBUTES_TO_RETAIN=ZM \\
            ATTRIBUTES_TO_RETAIN=ZC \\
            ATTRIBUTES_TO_RETAIN=ZN \\
            ATTRIBUTES_TO_RETAIN=ad \\  
            ATTRIBUTES_TO_RETAIN=bd \\ 
            ATTRIBUTES_TO_RETAIN=cd \\
            ATTRIBUTES_TO_RETAIN=ae \\
            ATTRIBUTES_TO_RETAIN=be \\
            ATTRIBUTES_TO_RETAIN=ce \\
            2>&1 | tee {log}

        picard --java-options "-Xmx{params.mem}g" AddOrReplaceReadGroups \\
            I={output.no_rg_bam} \\
            O={output.bam} \\
            RGID={wildcards.sample} \\
            RGLB=Library1 \\
            RGPL=Illumina \\
            RGSM={wildcards.sample} \\
            RGPU=NA \\
            CREATE_INDEX=true \\
            2>&1 | tee -a {log}
        """

# ---------------------------------------------------------------------------
# Step 14 – Picard CollectHsMetrics  (PDF step 10a)
# Post-consensus QC: fold-80, coverage, off-target rates.
# ---------------------------------------------------------------------------

rule collect_hs_metrics_post:
    """
    PDF command:
      java -Xmx4g -jar picard.jar CollectHsMetrics \\
        -I {consensus_aligned_merged_bam} \\
        -O {metrics_file}	\\
        -R {reference_fasta} \\
        --BAIT_INTERVALS {probes_intervals} \\
        --TARGET_INTERVALS	target_file_UMI_demo_data_hg38.bed	\\		
        --PER_TARGET_COVERAGE	probe_file_UMI_demo_data_hg38.bed
    """
    input:
        bam = f"{RESULTS}/bam/{{sample}}.consensus_final.bam"
    output:
        metrics = f"{RESULTS}/qc/{{sample}}.consensus_hs_metrics.txt"
    params:
        mem = MEMORY,
        ref = REFERENCE,
        bait_intervals = config["bait_intervals"],
        target_intervals = config["target_intervals"],
        probe_file = config["probe_file"]
    log:
        f"{LOGS}/qc/{{sample}}.consensus_hs_metrics.log"
    envmodules:
        MODULES["picard"],
        MODULES["java"]
    shell:
        """
        picard --java-options "-Xmx{params.mem}g" CollectHsMetrics \\
            -I {input.bam} \\
            -R {params.ref} \\
            -O {output.metrics} \\
            --BAIT_INTERVALS {params.bait_intervals} \\
            --TARGET_INTERVALS {params.target_intervals} \\
            --PER_TARGET_COVERAGE {params.probe_file} \\
            2>&1 | tee {log}
        """

# ---------------------------------------------------------------------------
# MultiQC
# Aggregate all QC reports (FastQC + HsMetrics)
# ---------------------------------------------------------------------------

rule multiqc:
    input:
        expand(f"{RESULTS}/qc/fastqc/{{sample}}.{{read}}_fastqc.zip",
               sample=SAMPLE_NAMES, read=["R1", "R2"]),
        expand(f"{RESULTS}/qc/{{sample}}.pre_consensus_hs_metrics.txt",
               sample=SAMPLE_NAMES),
        expand(f"{RESULTS}/qc/{{sample}}.consensus_hs_metrics.txt",
               sample=SAMPLE_NAMES)
    output:
        f"{RESULTS}/qc/multiqc_report.html"
    params:
        indir = f"{RESULTS}/qc",
        outdir = f"{RESULTS}/qc"
    log:
        f"{LOGS}/qc/multiqc.log"
    envmodules:
        MODULES["multiqc"]
    shell:
        "multiqc {params.indir} -o {params.outdir} -f --exclude fastqc 2>&1 | tee {log}"


# ---------------------------------------------------------------------------
# Summary report
# ---------------------------------------------------------------------------

rule generate_summary_report:
    input:
        expand(f"{RESULTS}/umi_extracted/{{sample}}.umi_stats.txt",        sample=SAMPLE_NAMES),
        expand(f"{RESULTS}/bam/{{sample}}.family_size_histogram.txt",   sample=SAMPLE_NAMES),
        expand(f"{RESULTS}/bam/{{sample}}.consensus_final.bam", sample=SAMPLE_NAMES)
    output:
        report = f"{RESULTS}/summary_report.txt"
    log:
        f"{LOGS}/summary.log"
    envmodules:
        MODULES["python"]
    script:
        "scripts/generate_summary.py"
